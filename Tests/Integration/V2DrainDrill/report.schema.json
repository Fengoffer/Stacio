{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["scenarioID", "buildCommit", "result", "redactedSummary", "cleanupVerification"],
  "properties": {
    "scenarioID": { "type": "string" },
    "buildCommit": { "type": "string" },
    "result": { "enum": ["pass", "fail", "blocked", "skipped"] },
    "statusReason": { "type": "string" },
    "redactedSummary": { "type": "string" },
    "cleanupVerification": { "type": "boolean" }
  }
}
